# Production document analysis: private PaddleOCR first, then the company's
# OpenAI-compatible MiniMax endpoint. Store both credentials in Secret Manager;
# never commit them here.
LLM_PROVIDER=newapi
NEWAPI_BASE_URL=https://newapi.elevatesphere.com/v1
NEWAPI_MODEL=gpustack-minimax-m2.7
NEWAPI_API_KEY=
NEWAPI_TIMEOUT_MS=180000
NEWAPI_MAX_TOKENS=4096
NEWAPI_MAX_TEXT_CHARS=18000

PADDLEOCR_BASE_URL=https://kyc-paddleocr-qam2sdmeuq-df.a.run.app
PADDLEOCR_AUTH_MODE=google_id_token
PADDLEOCR_API_KEY=
PADDLEOCR_REQUIRED=true
PADDLEOCR_TIMEOUT_MS=180000
PADDLEOCR_MAX_INPUT_BYTES=20971520
PADDLEOCR_MAX_TEXT_CHARS=50000
PADDLEOCR_MIN_SCORE=0.35

# Optional local fallback for development only.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:0.5b
OLLAMA_AUTH_MODE=none
OLLAMA_TIMEOUT_MS=120000

# Optional Claude fallback. Do not bind this key to the production service
# while LLM_PROVIDER=ollama.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
GOOGLE_CLOUD_PROJECT=
KYC_DOCUMENT_BUCKET=
# Firebase/Identity Platform web configuration. The API key is public client
# configuration, but keep environment-specific values out of source control.
FIREBASE_API_KEY=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=liubetty007@gmail.com
KYC_TEAM_EMAIL=liubetty007@gmail.com

# Betty demo Drive (see config/betty-drive.defaults.json)
KYC_DRIVE_ROOT_FOLDER_ID=1ROwiFHPpJyE7zHQGHQanAY43QHrc6eRF
KYC_DRIVE_CASES_FOLDER_ID=19D4sdsUdMMnRiIiaEFDhnmBywsw3W7H3
KYC_DRIVE_TEMPLATES_FOLDER_ID=10ZLHl60DJijG1S5Rvc0aqTdv08TiJxyx
